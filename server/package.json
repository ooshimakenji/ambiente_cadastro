    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.12.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
