# SQLite local (v1). Na migração p/ Postgres: trocar provider no schema.prisma e a URL abaixo.
DATABASE_URL="file:./dev.db"

# Segredo do JWT (trocar por valor forte). Token de curta duração (~15min, alinhado ao auto-logout).
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="15m"
# Expiração do token do ADMIN (dono) — sessão longa, não cai por inatividade.
# Trade-off de segurança: se um token admin vazar, fica válido por mais tempo.
JWT_EXPIRES_IN_ADMIN="12h"

# Porta da API e origem permitida no CORS (app Vite em dev)
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Usuário ADMIN inicial (consumido pelo seed)
ADMIN_LOGIN="admin"
ADMIN_SENHA="admin123"
ADMIN_NOME="Administrador"
